generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  one_month
  three_months
  lifetime
  student
  one_month_student
  three_months_student
  trial_7days
  hsk_advanced
}

enum OrderStatus {
  created
  pending
  paid
  failed
  cancelled
  expired
}

enum LicenseStatus {
  active
  revoked
}

enum EmailStatus {
  pending
  sending
  sent
  failed
}

enum UserStatus {
  active
  disabled
  deleted
}

enum AuthTokenKind {
  email_verify
  password_reset
}

model Order {
  id                 String         @id @default(cuid())
  invoiceNumber      String         @unique
  plan               Plan
  amountVnd          Int
  currency           String         @default("VND")
  email              String
  status             OrderStatus    @default(created)
  sepayOrderId        String?
  sepayTransactionId String?
  rawIpnJson         Json?
  expiresAt          DateTime
  paidAt             DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  license            License?
  paymentEvents      PaymentEvent[]
  emailOutbox        EmailOutbox[]
  audits             AuditLog[]

  @@index([email])
  @@index([status, expiresAt])
}

model PaymentEvent {
  id                 String   @id @default(cuid())
  orderId            String?
  sepayTransactionId String   @unique
  eventType          String
  status             String
  rawJson            Json
  receivedAt         DateTime @default(now())
  order              Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model License {
  id               String        @id @default(cuid())
  licenseKeyHash   String        @unique
  licenseKeyPrefix String
  orderId          String?       @unique
  email            String
  plan             Plan
  status           LicenseStatus @default(active)
  deviceLimit      Int
  expiresAt        DateTime?
  userId           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  order            Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  activations      Activation[]
  emailOutbox      EmailOutbox[]
  audits           AuditLog[]

  @@index([email])
  @@index([status])
  @@index([userId])
}

model Activation {
  id               String   @id @default(cuid())
  licenseId        String
  deviceIdHash     String
  deviceLabel      String?
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  license          License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, deviceIdHash])
  @@index([deviceIdHash])
}

model EmailOutbox {
  id          String      @id @default(cuid())
  dedupeKey   String      @unique
  type        String
  recipient   String
  orderId     String?
  licenseId   String?
  payload     Json
  status      EmailStatus @default(pending)
  attempts    Int         @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  license     License?    @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  orderId   String?
  licenseId String?
  metadata  Json?
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  license   License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}

// Short DB-backed share links (/s/<id>). Integrity is app-enforced: badge rows
// carry badgeKey, stats rows carry streak/words/level. No PII — just the public
// card payload. See docs/superpowers/specs/2026-07-03-share-short-links-design.md
model ShareCard {
  id         String   @id
  kind       String
  badgeKey   String?
  streak     Int?
  words      Int?
  level      Int?
  lang       String
  clickCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  emailVerifiedAt  DateTime?
  passwordHash     String
  name             String?
  age              Int?
  status           UserStatus  @default(active)
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sessions         Session[]
  authTokens       AuthToken[]
  licenses         License[]
  syncCursor       SyncCursor?
  syncEvents       SyncEvent[]
  syncVocabCards   SyncVocabCard[]
}

model AuthThrottle {
  key     String   @id
  count   Int
  resetAt DateTime
}

model AuthToken {
  id         String        @id @default(cuid())
  userId     String
  purpose    AuthTokenKind
  tokenHash  String        @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  deviceIdHash String
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceIdHash])
  @@index([userId])
}

enum SyncEventType {
  review
  master
  unmaster
}

/// One monotonic USN counter per account. Assigned under SELECT ... FOR UPDATE
/// on this row so concurrent pushes from two devices never collide.
model SyncCursor {
  userId String @id
  usn    Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Append-only learning events (review + manual master/unmaster). Replayed in
/// client-timestamp order to rebuild srs_state + mastered state. Never updated
/// or deleted (append-only) — no tombstone.
model SyncEvent {
  id           String        @id @default(cuid())
  userId       String
  eventId      String        // client-generated UUID — idempotency key
  eventType    SyncEventType
  cardUid      String        // cross-device card identity (string, not FK)
  rating       Int?          // present iff eventType = review (DB CHECK in constraints migration)
  occurredAt   DateTime      @db.Timestamptz(3) // client event time (replay order)
  deviceIdHash String        // sort tiebreaker + clock-skew attribution
  usn          Int
  receivedAt   DateTime      @default(now()) @db.Timestamptz(3) // server receive time
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@unique([userId, usn])
  @@index([userId, usn])
  @@index([userId, cardUid])
}

/// User-added cards only (seed/deck cards are shipped, never synced as content).
/// Last-write-wins by clientUpdatedAt; soft-delete via deletedAt tombstone.
model SyncVocabCard {
  id              String    @id @default(cuid())
  userId          String
  cardUid         String
  normalizedWord  String
  language        String
  word            String
  meaning         String
  example         String?
  pos             String?
  pinyin          String?
  toneMarks       String?
  exampleVi       String?
  usn             Int
  deletedAt       DateTime? @db.Timestamptz(3)
  clientUpdatedAt DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardUid])
  @@unique([userId, usn])
  @@index([userId, usn])
}
