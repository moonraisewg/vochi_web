DATABASE_URL="postgresql://vochi:vochi@localhost:5432/vochi"

SEPAY_ENV="sandbox"
SEPAY_MERCHANT_ID="your-sepay-merchant-id"
SEPAY_SECRET_KEY="your-sepay-secret-key"
SEPAY_IPN_SECRET_KEY="your-sepay-ipn-secret"

APP_BASE_URL="https://vochi.app"

# Origin of the standalone vochi-api backend. A handful of client-side pages
# (checkout, verify-email, reset-password, CheckoutResult) fetch this app's
# own /api/* routes directly from the browser — set this so those calls hit
# the new backend instead. Leave empty for local dev against this app's own
# bundled API routes.
NEXT_PUBLIC_API_BASE_URL=""

RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Vô chi <licenses@vochi.app>"

# Base64url-encoded 32-byte Ed25519 seed and public key.
LICENSE_SIGNING_PRIVATE_KEY="base64url-32-byte-ed25519-seed"
LICENSE_PUBLIC_KEY="base64url-32-byte-ed25519-public-key"

# Used to encrypt the full license key while queued for email/support resend.
LICENSE_KEY_ENCRYPTION_SECRET="at-least-32-characters-random-secret"

# 32-byte base64url MASTER key for the "HSK nâng cao" pack (HSK 4/5/6).
# MUST equal the desktop build secret VOCHI_PACK_KEY_HSK_ADVANCED (same value
# both sides). Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Optional: only needed once the pack is on sale.
PACK_KEY_HSK_ADVANCED="base64url-32-byte-master-key"

# Google OAuth (Desktop-app client). GOOGLE_CLIENT_ID must equal the value the
# desktop build embeds. Secret is server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth (Mobile clients for id_token verification).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Optional secret for cron/admin jobs.
JOB_SECRET="at-least-24-characters-random-secret"

# Cloudflare R2 - for scripts/publish-release.sh
CLOUDFLARE_API_TOKEN=cfut_...

# PostHog analytics (client). Leave NEXT_PUBLIC_POSTHOG_KEY empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Cloudflare Turnstile — site key CÔNG KHAI (nhúng vào HTML, lộ không sao).
# Secret key tương ứng thuộc về vochi-api (Railway), KHÔNG đặt ở repo này:
# tiền tố NEXT_PUBLIC_ nhúng thẳng giá trị vào bundle trình duyệt.
# Tạo widget: dash.cloudflare.com → Turnstile → Add widget → hostnames
# vochi.xyz + localhost, mode Managed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# PDF lead magnet mà popup thu email hứa gửi, host trên R2 (bucket
# vochi-releases, prefix lead-magnet/). Bỏ trống thì /tai-lieu hiện dòng
# "chưa cấu hình" thay vì một nút bấm vào không ra gì.
# Đổi nội dung file thì upload tên -v2 rồi sửa biến — R2 public URL có cache.
NEXT_PUBLIC_LEAD_MAGNET_URL=""
